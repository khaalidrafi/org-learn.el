;;; Commentary:

;; ERT suite for the spec 015 core segment: topic sources (subtree,
;; org-learn-file), the cap law, milestone grouping, byte-exact
;; rendering, the batch-safe core, and the command's offer seams --
;; all deterministic, zero network, org-roadmap reached only through
;; the `org-learn-plan--roadmap-available-p' seam (the spec 011 law).

;;; Code:

(require 'ert)
(require 'org-learn)
(require 'org-learn-plan)

(defun org-learn-plan-test--kill-plan ()
  "Kill the plan buffer, leaving no litter behind."
  (let ((buf (get-buffer org-learn-plan-buffer-name)))
    (when buf
      (with-current-buffer buf (set-buffer-modified-p nil))
      (kill-buffer buf))))

;;;; Milestone grouping (pure)

(ert-deftest org-learn-plan-milestones-chunk-seven-at-three ()
  "The pinned worked case: seven topics at size 3 group (3, 3, 1)."
  (let ((org-learn-plan-milestone-size 3)
        (topics '("a" "b" "c" "d" "e" "f" "g")))
    (should (equal (org-learn-plan--milestones topics)
                   '(("a" "a" "b" "c")
                     ("d" "d" "e" "f")
                     ("g" "g"))))))

(ert-deftest org-learn-plan-milestones-guards ()
  "Empty topics give nil; a non-positive size is a user error."
  (should (null (org-learn-plan--milestones nil)))
  (let ((org-learn-plan-milestone-size 0))
    (should (string-match-p
             ">= 1"
             (error-message-string
              (should-error (org-learn-plan--milestones '("a"))
                            :type 'user-error))))))

;;;; Render law (pure, byte-exact)

(ert-deftest org-learn-plan-render-is-byte-exact ()
  "The plan text matches the spec 015 format law exactly."
  (let ((text (org-learn-plan--render
               "Learn Org mode" "subtree"
               '(("Org syntax" "Org syntax" "Headings and stars")
                 ("Review scheduling" "Review scheduling")))))
    (should (string= text
                     "* TODO Plan: Learn Org mode
  :PROPERTIES:
  :GOAL: Learn Org mode
  :SOURCE: subtree
  :END:
** TODO Milestone 1: Org syntax
*** TODO Org syntax
*** TODO Headings and stars
** TODO Milestone 2: Review scheduling
*** TODO Review scheduling

# Generated by org-learn plan (spec 015) from subtree.\n"))))

;;;; Topic sources

(ert-deftest org-learn-plan-subtree-topics-order-and-dedupe ()
  "Subtree topics: strictly-inside headings, document order,
trimmed, deduplicated first-wins, root excluded."
  (with-temp-buffer
    (org-mode)
    (insert "* Root goal\n** Org syntax\n** Capture\n   \n** Org syntax\n*** Deeper\n")
    (goto-char (point-min))
    (should (equal (org-learn-plan--subtree-topics)
                   '("Org syntax" "Capture" "Deeper"))))
  ;; no heading, no org: nil
  (with-temp-buffer
    (should (null (org-learn-plan--subtree-topics)))))

(ert-deftest org-learn-plan-file-topics-todo-only ()
  "The notes-file branch reads TODO-state headings of org-learn-file."
  (let ((file (make-temp-file "org-learn-plan-test" nil ".org"))
        (org-learn-file nil))
    (with-temp-file file
      (insert "* TODO Learn Org mode\n* DONE Already learned\n* TODO Capture everything\n* Plain heading, not a todo\n"))
    (let ((org-learn-file (file-name-nondirectory file)))
      ;; org-learn-file is relative; chdir would be rude, so bind the
      ;; variable to the absolute path instead
      (let ((org-learn-file file))
        (unwind-protect
            (should (equal (org-learn-plan--file-topics)
                           '("Learn Org mode" "Capture everything")))
          (delete-file file))))))

(ert-deftest org-learn-plan-file-topics-missing-file-nil ()
  "A missing notes file reads as no topics, never an error."
  (let ((org-learn-file "/nonexistent/org-learn-plan-test.org"))
    (should (null (org-learn-plan--file-topics)))))

;;;; Cap law

(ert-deftest org-learn-plan-cap-truncates-and-messages ()
  "Past the cap the list truncates and the cut is messaged."
  (let ((org-learn-plan-max-topics 3)
        (topics '("a" "b" "c" "d" "e")))
    (should (equal (org-learn-plan--cap topics) '("a" "b" "c"))))
  (let ((org-learn-plan-max-topics 40))
    (should (equal (org-learn-plan--cap '("a")) '("a")))))

;;;; Core (batch-safe)

(ert-deftest org-learn-plan-core-guards-the-goal ()
  "A blank goal user-errors before any buffer is touched."
  (org-learn-plan-test--kill-plan)
  (with-temp-buffer
    (should (string-match-p
             "no goal for the plan"
             (error-message-string
              (should-error (org-learn-plan--generate "   ")
                            :type 'user-error)))))
  (should-not (get-buffer org-learn-plan-buffer-name)))

(ert-deftest org-learn-plan-core-guards-no-topics ()
  "No subtree and no notes file is a user error, no buffer litter."
  (org-learn-plan-test--kill-plan)
  (let ((org-learn-file "/nonexistent/org-learn-plan-test.org"))
    (with-temp-buffer
      (should (string-match-p
               "no notes to plan from"
               (error-message-string
                (should-error (org-learn-plan--generate "Learn Org")
                              :type 'user-error))))))
  (should-not (get-buffer org-learn-plan-buffer-name)))

(ert-deftest org-learn-plan-core-renders-into-plan-buffer ()
  "The core fills the plan buffer with the rendered plan, batch-safe,
org-mode, point at min, and replaces the previous draft."
  (org-learn-plan-test--kill-plan)
  (unwind-protect
      (with-temp-buffer
        (org-mode)
        (insert "* Learn Org mode\n** Org syntax\n** Capture\n** Review\n")
        (goto-char (point-min))
        (let ((buf (org-learn-plan--generate "Learn Org mode")))
          (should (eq buf (get-buffer org-learn-plan-buffer-name)))
          (with-current-buffer buf
            (should (derived-mode-p 'org-mode))
            (should (= (point) (point-min)))
            (goto-char (point-min))
            (should (looking-at-p "\\* TODO Plan: Learn Org mode$"))
            (should (string-match-p ":SOURCE: subtree" (buffer-string)))
            (should (string-suffix-p
                     "# Generated by org-learn plan (spec 015) from subtree.\n"
                     (buffer-string))))
          ;; regeneration replaces, not appends
          (org-learn-plan--generate "Second goal")
          (with-current-buffer buf
            (should (string-match-p "^\\* TODO Plan: Second goal$" (buffer-string)))
            (should-not (string-match-p "First" (buffer-string))))))
    (org-learn-plan-test--kill-plan)))

;;;; Command seams

(ert-deftest org-learn-plan-command-offers-and-messages ()
  "The command reads the goal with the heading default, pops the
plan buffer, messages the counts, and reaches org-roadmap only
through the seam; declined offers leave the draft."
  (org-learn-plan-test--kill-plan)
  (unwind-protect
      (with-temp-buffer
        (org-mode)
        (insert "* Learn Org mode\n** Org syntax\n** Capture\n** Review\n")
        (goto-char (point-min))
        (let ((seam-called 0)
              (drill-called 0)
              (saved nil)
              (goal-input nil))
          (cl-letf* (((symbol-function 'read-string)
                      (lambda (_prompt &optional _init _hist _default)
                        (setq goal-input "read")
                        "Learn Org mode"))
                     ((symbol-function 'org-learn-plan--roadmap-available-p)
                      (lambda () (setq seam-called (1+ seam-called)) t))
                     ((symbol-function 'org-learn-plan-from-roadmap)
                      (lambda () (setq drill-called (1+ drill-called))))
                     ((symbol-function 'yes-or-no-p)
                      (lambda (&rest _) nil))
                     ((symbol-function 'pop-to-buffer)
                      (lambda (&rest _) nil))
                     ((symbol-function 'read-file-name)
                      (lambda (_p &rest _) "/tmp/unused.org"))
                     ((symbol-function 'write-region)
                      (lambda (_b _e _f &rest _) (setq saved t)))
                     ((symbol-function 'message)
                      (lambda (_f &rest _)
                        (if (string-match-p "plan ready" (format "%s" _f))
                            (setq saved saved)
                          nil))))
            (let ((buf (org-learn-plan-generate)))
              (should (buffer-live-p buf))
              (should (= seam-called 1))
              (should (= drill-called 0)) ; declined
              (should-not saved)
              (with-current-buffer buf
                (should (string-match-p
                         "^\\* TODO Plan: Learn Org mode$"
                         (buffer-string))))))))
    (org-learn-plan-test--kill-plan)))

(ert-deftest org-learn-plan-command-accepts-drill-offer ()
  "Accepting the drill offer runs the bridge command on the plan,
after the seam answers true."
  (org-learn-plan-test--kill-plan)
  (unwind-protect
      (with-temp-buffer
        (org-mode)
        (insert "* Goal\n** Topic one\n** Topic two\n")
        (goto-char (point-min))
        (let ((drill-called 0))
          (cl-letf* (((symbol-function 'read-string)
                      (lambda (&optional _p _i _h _d) "Goal"))
                     ((symbol-function 'org-learn-plan--roadmap-available-p)
                      (lambda () t))
                     ((symbol-function 'org-learn-plan-from-roadmap)
                      (lambda () (setq drill-called (1+ drill-called))))
                     ((symbol-function 'yes-or-no-p)
                      (lambda (&rest _) t))
                     ((symbol-function 'pop-to-buffer) (lambda (&rest _) nil))
                     ((symbol-function 'read-file-name)
                      (lambda (_p &rest _) "/tmp/unused.org"))
                     ((symbol-function 'write-region)
                      (lambda (_b _e _f &rest _) nil)))
            (org-learn-plan-generate)
            (should (= drill-called 1)))))
    (org-learn-plan-test--kill-plan)))

(ert-deftest org-learn-plan-keeps-the-org-roadmap-boundary ()
  "The plan file never requires org-roadmap at top level (the
dependency law): the feature loads without it, the seam is the
only door."
  (should (fboundp 'org-learn-plan-generate))
  (should (fboundp 'org-learn-plan--roadmap-available-p)))

(ert-deftest org-learn-plan-autoload-is-declared ()
  "The spec 006 autoload law: org-learn.el carries the command."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "org-learn.el"
                                            default-directory))
    (should (string-match-p "(autoload 'org-learn-plan-generate"
                            (buffer-string)))))

(provide 'test-org-learn-plan)
